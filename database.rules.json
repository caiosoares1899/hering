{
  "rules": {
    "kanban": {
      "campanhas": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
      },
      "campanhas_log": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
      },
      "campanhas_log_dev": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
      },
      "dados_diarios": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
      },
      "dados_diarios_dev": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
      },
      "comunicados": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')",
        ".indexOn": ["ativo"]
      },
      "feedback": {
        ".read":  "auth != null && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/painel_viewers/' + auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).exists())",
        ".write": "auth != null"
      },
      "squads_meta": {
        ".read": "auth != null && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/painel_viewers/' + auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).exists())",
        ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
      },
      "squads": {
        "$squadId": {
          "dados": {
            ".read":  "auth != null && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/usuarios/' + auth.uid + '/squads/' + $squadId).val() === true || root.child('kanban/painel_viewers/' + auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).exists())",
            ".write": "auth != null && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/usuarios/' + auth.uid + '/squads/' + $squadId).val() === true)"
          },
          "presence": {
            ".read": "auth != null && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/painel_viewers/' + auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).exists())",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && auth.token.email.endsWith('@ciahering.com.br')"
            }
          },
          "snapshots": {
            ".read":  "auth != null && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/painel_viewers/' + auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).exists())",
            ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
          },
          "backups": {
            ".read":  "auth != null && auth.token.email.endsWith('@ciahering.com.br')",
            ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
          },
          "error_logs": {
            ".read":  "auth != null && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/painel_viewers/' + auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).exists())",
            ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
          },
          "error_stats": {
            ".read":  "auth != null && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/painel_viewers/' + auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).exists())",
            ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
          },
          "agent_usage": {
            ".read":  "auth != null && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/painel_viewers/' + auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).exists())",
            ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
          },
          "access_log": {
            ".read":  "auth != null && auth.token.email.endsWith('@ciahering.com.br')",
            ".write": "auth != null"
          },
          "externos": {
            ".read": "auth != null",
            ".write": "auth != null && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/usuarios/' + auth.uid + '/role').val() === 'po' || root.child('kanban/usuarios/' + auth.uid + '/role').val() === 'adm')"
          }
        }
      },
      "painel": {
        ".read":  "auth != null && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/painel_viewers/' + auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).exists())",
        ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
      },
      "painel_viewers": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
      },
      "config": {
        ".read":  "auth != null && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/painel_viewers/' + auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).exists())",
        ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
      },
      "spotify_secrets": {
        ".read": false,
        ".write": false
      },
      "spotify_radio_owner_secret": {
        ".read": false,
        ".write": false
      },
      "oauth_pending": {
        "$state": {
          ".read": false,
          ".write": "auth != null && newData.child('uid').val() === auth.uid"
        }
      },
      "usuarios": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || auth.token.email.endsWith('@ciahering.com.br') && (root.child('kanban/usuarios/' + auth.uid + '/role').val() === 'po' || root.child('kanban/usuarios/' + auth.uid + '/role').val() === 'adm' || auth.token.email === 'caio.soares@ciahering.com.br'))",
          "role": {
            ".validate": "auth.token.email.endsWith('@ciahering.com.br') && (root.child('kanban/usuarios/' + auth.uid + '/role').val() === 'po' || root.child('kanban/usuarios/' + auth.uid + '/role').val() === 'adm' || auth.token.email === 'caio.soares@ciahering.com.br') || newData.val() === data.val() || (!data.exists() && (newData.val() === 'membro' || newData.val() === 'convidado')) || (data.val() === 'convidado' && newData.val() === 'membro' && auth.uid === $uid)"
          },
          "squads": {
            "$squadId": {
              ".validate": "newData.val() === null || (newData.val() === true && (auth.token.email.endsWith('@ciahering.com.br') || root.child('kanban/squads/' + $squadId + '/externos/' + auth.token.email.toLowerCase().replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).exists()))"
            }
          },
          "notificacoes": {
            "$notifId": {
              ".write": "auth != null && (!data.exists() || auth.uid === $uid || root.child('kanban/usuarios/' + auth.uid + '/role').val() === 'po' || root.child('kanban/usuarios/' + auth.uid + '/role').val() === 'adm')"
            }
          }
        }
      },
      "usuarios_publicos": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || auth.token.email.endsWith('@ciahering.com.br') && (root.child('kanban/usuarios/' + auth.uid + '/role').val() === 'po' || root.child('kanban/usuarios/' + auth.uid + '/role').val() === 'adm' || auth.token.email === 'caio.soares@ciahering.com.br'))"
        }
      },
      "presence": {
        ".read": "auth != null && auth.token.email.endsWith('@ciahering.com.br')",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && auth.token.email.endsWith('@ciahering.com.br')"
        }
      },
      "global": {
        "force_logout_after": {
          ".read":  "auth != null",
          ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
        },
        "force_logout_after_dev": {
          ".read":  "auth != null",
          ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
        },
        "idle_logout_config": {
          ".read":  "auth != null",
          ".write": "auth != null && auth.token.email.endsWith('@ciahering.com.br')"
        }
      }
    }
  }
}